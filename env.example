# All variables below are OPTIONAL for local use.
# The CLI stores credentials in ~/.config/cursor-claude/auth.json by default.
#
# Only set the Redis variables if you're deploying the proxy remotely
# (e.g. on Vercel) and need shared credential storage.

# --- Storage (remote deployments only) -----------------------------------

# Option A — any standard Redis (TCP). Takes precedence when set.
# Examples: redis://127.0.0.1:6379   redis://:password@localhost:6379
REDIS_URL=

# Option B — Upstash (HTTPS REST). Used only when REDIS_URL is unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Proxy auth ----------------------------------------------------------

# Optional shared secret. If set, clients must send this value as the API key.
# Recommended when exposing the proxy outside of localhost.
API_KEY=

# --- Advanced ------------------------------------------------------------

# Override the Anthropic OAuth client id. Defaults to the official Claude CLI id.
# ANTHROPIC_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e

# Default listening port for `cursor-claude start`. Overridden by --port.
# PORT=9095

# Optional: config + credentials live under ${XDG_CONFIG_HOME}/cursor-claude/
# when set; otherwise the OS default config path (e.g. ~/.config/cursor-claude).
# XDG_CONFIG_HOME=

# The CLI loads `.env` from the current working directory only (not from HOME).
